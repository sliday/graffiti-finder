# Copy to .env and fill in your own values. .env is gitignored.

# --- Mapillary --------------------------------------------------------------
# Required. Create an app at https://www.mapillary.com/dashboard/developers
# and copy the Client Token (MLY|<app_id>|<secret>).
MAPILLARY_APP_ID=
MAPILLARY_ACCESS_TOKEN=
MAPILLARY_CLIENT_SECRET=

# --- Krakow Survey123 endpoints (defaults work; override only to point at a
# different city's instance) --------------------------------------------------
SURVEY123_ITEM_ID=b996fb8c744f41a69c5d51729702c55b
SURVEY123_PORTAL=https://bezpiecznie.um.krakow.pl/portal
SURVEY123_SHARE_URL=https://survey123.arcgis.com/share/b996fb8c744f41a69c5d51729702c55b?portalUrl=https://bezpiecznie.um.krakow.pl/portal

# --- HTTP courtesy ----------------------------------------------------------
# OpenStreetMap Nominatim asks for a real UA. Put your project + contact here.
NOMINATIM_UA=graffiti-finder/0.1 (+https://github.com/sliday/graffiti-finder)

# --- HuggingFace ------------------------------------------------------------
# Optional. Without a token, public models still download but rate limits are
# tighter. Required if you ever try a gated model (e.g. facebook/sam3 direct).
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
