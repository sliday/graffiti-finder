# Local secrets — Mapillary token, HF token, etc.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Detection state — SQLite queue + WAL + journal
data/store.sqlite
data/store.sqlite-journal
data/store.sqlite-wal
data/store.sqlite-shm

# Mapillary thumbnail + crop cache (regenerable by walking)
data/images/

# Per-run logs and proposed.jsonl exports
data/runs/

# Build/regenerable artifacts
data/queue_viz/
data/queue_gallery.html
data/diag/
data/embeddings/
data/samples/sample_*.jpg
data/samples/detections/
data/samples/tune/
data/samples/sam3_vs_dino/
data/samples/detection_*.json
data/samples/tune_*.json
data/samples/*.html

# Form binary (city portal redistributes it — re-fetch via CLI)
data/form/Gravvitti_v_1.zip
data/form/extracted/

# Heritage cache (regenerable via Overpass)
# data/heritage/   # ← keep checked in: small (~600KB), avoids cold-start Overpass query

# Cloudflare Pages deploy dir (generated by scripts/build_public.sh)
public/

# SAM3 + mlx-sam3 are external; user clones into vendor/ via README
vendor/

# Editor + OS
codedb.snapshot
.DS_Store
.idea/
.vscode/
*.bak
