{
  "form": "<form autocomplete=\"off\" novalidate=\"novalidate\" class=\"or clearfix\" dir=\"ltr\" data-form-id=\"Graffitti_v1_2\" action=\"https://bezpiecznie.um.krakow.pl/portal/sharing/rest/content/items/fc26d76f8cfb4b478ae6132446459f28\" method=\"post\">\n<!--This form was created by transforming an ODK/OpenRosa-flavored (X)Form using an XSL stylesheet created by Enketo LLC.--><section class=\"form-logo\"></section><h3 dir=\"auto\" id=\"form-title\">Graffitti_v1</h3><label class=\"question non-select or-appearance-press-to-locate\"><div class=\"label-container\"><span lang=\"\" class=\"question-label active\" id=\"id1\">&lt;b&gt;Wskaż lokalizację graffiti&lt;/b&gt;</span><span class=\"required\" id=\"id2\">*</span></div><input type=\"text\" name=\"/Gravvitti_v_1/Graffitti_v1_point\" data-required=\"true()\" data-type-xml=\"geopoint\" id=\"id3\" style=\"display: none;\"><div class=\"esri-geo widget\">\n    <div class=\"widget-popup-close\"></div>\n    <div class=\"map-wrapper\">\n      <div class=\"loading\">\n        <div class=\"content\">\n          <div class=\"survey123-loading-bar\">\n            <div class=\"loading-bar\"></div><div class=\"loading-bar\"></div><div class=\"loading-bar\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- MASK SECTION -->\n      <div class=\"scrollMask\" style=\"transition:0.5s opacity ease-in-out;\">\n      </div>\n\n      <!-- MAP SECTION -->\n      <div class=\"map-canvas-wrapper\">\n        <div class=\"map-canvas\"></div>\n        <div class=\"info\"></div>\n      </div>\n\n      <!-- TOOLS SECTION -->\n      <div class=\"geo-controller\">\n\n        <!-- ICON SECTION -->\n        <div class=\"geo-icon-section\"></div>\n\n        <!-- INPUT SECTION -->\n        <div class=\"geo-input-section\"></div>\n      </div>\n    </div>\n  </div><span class=\"or-required-msg active\" lang=\"\" id=\"id3\" data-i18n=\"constraint.required\">This field is required</span></label><label class=\"question non-select \"><div class=\"label-container\"><span lang=\"\" class=\"question-label active\" id=\"id4\">Data zgłoszenia:</span></div><input type=\"datetime-local\" name=\"/Gravvitti_v_1/data_zgloszenia\" data-required=\"true()\" data-type-xml=\"dateTime\" readonly=\"\" id=\"id5\"><span class=\"or-required-msg active\" lang=\"\" id=\"id5\" data-i18n=\"constraint.required\">This field is required</span></label><label class=\"question non-select \"><div class=\"label-container\"><span lang=\"\" class=\"question-label active\" id=\"id6\">Dodaj zdjęcie graffiti (maksymalna wielkość 10 MB):</span></div><input type=\"file\" name=\"/Gravvitti_v_1/Graffitti_v1_image\" data-type-xml=\"binary\" accept=\"image/*\" id=\"id7\"></label><label class=\"question or-appearance-minimal\"><div class=\"label-container\"><span lang=\"\" class=\"question-label active\" id=\"id13\">Podaj rodzaj graffiti:</span></div><select name=\"/Gravvitti_v_1/rodzaj_graffitti\" data-name=\"/Gravvitti_v_1/rodzaj_graffitti\" data-type-xml=\"select1\" id=\"id14\"><option value=\"\">...</option><option value=\"brak\">\"\"</option><option value=\"bazgroly\">bazgroły</option><option value=\"mowa nienawisci\">mowa nienawiści</option><option value=\"mural\">mural</option><option value=\"inne\">inne</option></select><span class=\"or-option-translations\" style=\"display:none;\">\n                </span></label><label class=\"question or-appearance-minimal\"><div class=\"label-container\"><span lang=\"\" class=\"question-label active\" id=\"id22\">Miejsce graffiti:</span></div><select name=\"/Gravvitti_v_1/miejsce_graffitti\" data-name=\"/Gravvitti_v_1/miejsce_graffitti\" data-type-xml=\"select1\" id=\"id23\"><option value=\"\">...</option><option value=\"brak\">\"\"</option><option value=\"sciana budynku\">ściana budynku</option><option value=\"ogrodzenie\">ogrodzenie (mur oporowy)</option><option value=\"filar mostu\">filar mostu (wiaduktu)</option><option value=\"wiata\">wiata śmietnikowa</option><option value=\"garaz\">garaż 